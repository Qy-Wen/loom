{
  "name": "@loom/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./composer-image": "./src/composer-image.ts",
    "./attachments": "./src/attachments.ts",
    "./composer-asset": "./src/composer-asset.ts",
    "./tool-permission": "./src/tool-permission.ts",
    "./durable": "./src/durable-adapter.ts"
  },
  "imports": {
    "#vendor/pi-durable": "./vendor-pi-durable/src/index.ts",
    "#vendor/pi-durable/tools": "./vendor-pi-durable/src/tools/index.ts",
    "#vendor/pi-durable/codemode": "./vendor-pi-durable/src/codemode/index.ts",
    "#vendor/pi-durable/env/node": "./vendor-pi-durable/src/env/node.ts",
    "#vendor/pi-durable/images/node": "./vendor-pi-durable/src/images/node.ts",
    "#vendor/pi-durable/storage/sqlite/node": "./vendor-pi-durable/src/storage/sqlite/node.ts",
    "#vendor/pi-durable/storage/jsonl/node": "./vendor-pi-durable/src/storage/jsonl/node.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "try:agent": "node --experimental-strip-types --env-file=../../.env scripts/try-agent.ts",
    "try:durable": "node --experimental-strip-types --env-file=../../.env scripts/try-durable.ts",
    "eval:compaction-rate": "node --experimental-strip-types --env-file=../../.env evals/compaction-rate.ts",
    "eval:compaction-e2e": "node --experimental-strip-types --env-file=../../.env evals/compaction-e2e.ts",
    "eval:prompt-cache-hit": "node --experimental-strip-types --env-file=../../.env evals/prompt-cache-hit.ts",
    "eval:agent-tools": "node --experimental-strip-types evals/agent-tools.ts",
    "eval:agent-tools:live": "node --experimental-strip-types --env-file=../../.env evals/agent-tools.ts --live",
    "vendor:sync": "node vendor-pi-durable/sync.mjs",
    "typecheck:vendor": "tsc --noEmit -p tsconfig.vendor.json",
    "build:vendor": "pnpm --filter @earendil-works/pi-codemode build && tsc -p tsconfig.vendor-build.json",
    "test:vendor": "node --experimental-strip-types --test vendor-tests/*.test.ts",
    "test:vendor:build": "pnpm build:vendor && node --conditions=loom-vendor-build --test vendor-tests/build.test.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@loom/core": "workspace:*",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-codemode": "workspace:*",
    "@earendil-works/pi-telemetry": "1.1.0",
    "@silvia-odwyer/photon": "0.3.3",
    "diff": "8.0.4",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
