{
  "name": "@loom/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./composer-image": "./src/composer-image.ts",
    "./composer-asset": "./src/composer-asset.ts"
  },
  "imports": {
    "#vendor/pi-agent": "./vendor-pi-agent/src/index.ts",
    "#vendor/pi-agent/node": "./vendor-pi-agent/src/node.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "try:agent": "node --experimental-strip-types --env-file=../../.env scripts/try-agent.ts",
    "eval:compaction-rate": "node --experimental-strip-types --env-file=../../.env evals/compaction-rate.ts",
    "eval:compaction-e2e": "node --experimental-strip-types --env-file=../../.env evals/compaction-e2e.ts",
    "eval:prompt-cache-hit": "node --experimental-strip-types --env-file=../../.env evals/prompt-cache-hit.ts",
    "eval:agent-tools": "node --experimental-strip-types evals/agent-tools.ts",
    "eval:agent-tools:live": "node --experimental-strip-types --env-file=../../.env evals/agent-tools.ts --live",
    "vendor:sync": "./vendor-pi-agent/sync.sh"
  },
  "dependencies": {
    "@earendil-works/chord": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-telemetry": "0.85.1",
    "@silvia-odwyer/photon-node": "0.3.4",
    "diff": "8.0.4",
    "ignore": "7.0.8",
    "typebox": "1.3.27",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
