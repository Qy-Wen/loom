{
  "name": "@loom/ag-ui-react",
  "version": "0.1.0",
  "description": "React hooks and chat components for AG-UI agents",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "src", "README.zh-CN.md"],
  "exports": {
    ".": {
      "loom-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./chat-view": {
      "loom-source": "./src/chat-view.tsx",
      "types": "./dist/chat-view.d.ts",
      "import": "./dist/chat-view.js"
    },
    "./markdown": {
      "loom-source": "./src/markdown.tsx",
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./markdown.css": "./src/markdown.css"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@ag-ui/client": "^1.0.1",
    "react": "^18.3.0 || ^19.0.0",
    "streamdown": "1.3.0"
  },
  "peerDependenciesMeta": {
    "streamdown": { "optional": true }
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.1",
    "@types/react": "19.2.2",
    "react": "19.2.0",
    "streamdown": "1.3.0",
    "typescript": "5.9.3"
  }
}
