{
  "name": "@loom/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./grade": "./src/grade/index.ts",
    "./sandbox": "./src/sandbox/process-sandbox.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test --test-force-exit tests/*.test.ts",
    "eval:retrieval": "node --experimental-strip-types evals/retrieval.ts",
    "eval:retrieval:live": "node --experimental-strip-types --env-file=../../.env evals/retrieval.ts --live"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.78",
    "@ladybugdb/wasm-core": "0.20.4",
    "better-sqlite3": "13.0.3",
    "chokidar": "4.0.3",
    "js-tiktoken": "1.0.21",
    "markdown-it": "15.0.2",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
