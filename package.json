{
  "name": "loom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @loom/app test:e2e",
    "test:e2e:attach": "pnpm --filter @loom/app test:e2e:attach",
    "dev": "pnpm --filter @loom/app dev",
    "dist": "node scripts/dist.mjs",
    "release": "node scripts/release.mjs",
    "website:dev": "node website/scripts/serve.mjs",
    "website:build": "node website/scripts/build.mjs",
    "website:deploy": "node website/scripts/deploy.mjs",
    "postinstall": "node scripts/download-ffmpeg.mjs && node scripts/ensure-windows-sandbox.mjs",
    "vendor:sync": "pnpm --filter @loom/agent vendor:sync",
    "vendor:ffmpeg": "node scripts/download-ffmpeg.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.19"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": ["darwin", "win32"],
      "cpu": ["arm64", "x64"]
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ],
    "overrides": {
      "streamdown": "1.3.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@types/express": "4"
      }
    }
  }
}
