{
  "name": "loom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @loom/app test:e2e",
    "test:e2e:attach": "pnpm --filter @loom/app test:e2e:attach",
    "dev": "pnpm --filter @loom/app dev",
    "vendor:sync": "pnpm --filter @loom/agent vendor:sync",
    "vendor:ffmpeg": "node scripts/download-ffmpeg.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.19"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ],
    "overrides": {
      "streamdown": "1.3.0"
    }
  }
}
